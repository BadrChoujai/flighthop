# Flighthop reads its upstream endpoints from the environment.
#
# Nothing below is a secret. These are an airline's own website endpoints —
# unauthenticated, undocumented, and visible in any browser's network tab. They
# live here rather than in the source so that this repository is a flight search
# engine that happens to call something, not a guide to calling it.
#
# Filling this in takes about five minutes. Open the airline's own site with
# devtools on the Network tab, filter to Fetch/XHR, and read the paths off the
# requests the site makes as you search. Write them below as templates:
# {code} {from} {to} {year} {month} {date} are substituted at call time.
#
# Copy this file to .env. The dev server loads it automatically. On a host, set
# the same variables in the project's environment settings instead.

# Origin every API path hangs off, no trailing slash.
FLIGHTHOP_API_BASE=https://www.example-airline.com

# Airport master table. Must carry, per airport: IATA code, city, country,
# latitude, longitude, and the IANA timezone name. The timezone is not optional —
# the fare feeds return local wall-clock times with no offset, and without a zone
# every layover across a border is wrong by one to three hours.
FLIGHTHOP_PATH_AIRPORTS=/path/to/active-airports

# Every route out of one airport — the edge list of the network. Needs {code}.
FLIGHTHOP_PATH_ROUTES=/path/to/routes-from/{code}

# One month of one route: cheapest fare per day, each with local departure and
# arrival times. This is the endpoint the whole app's speed rests on — a month in
# one request rather than one request per date. Needs {from} and {to}. Called with
# ?outboundMonthOfDate=YYYY-MM-01&currency=EUR appended.
FLIGHTHOP_PATH_CHEAPEST_PER_DAY=/path/to/fares/{from}/{to}/cheapest-per-day

# Published timetable for one route in one month: every frequency, with flight
# numbers. The fare feed only ever returns the cheapest flight per day, so this is
# the only source for "is there a later flight if I miss this one".
# Needs {from}, {to}, {year}, {month}.
FLIGHTHOP_PATH_TIMETABLE=/path/to/schedules/{from}/{to}/{year}/{month}

# Which dates a route operates at all. A cheap pre-filter. Needs {from}, {to}.
FLIGHTHOP_PATH_AVAILABILITIES=/path/to/fares/{from}/{to}/availabilities

# "Anywhere" search: one call ranking every destination out of an airport.
# Called with a query string of departure airport, date window, price cap and
# time-of-day window.
FLIGHTHOP_PATH_ONE_WAY_FARES=/path/to/one-way-fares

# The same, both directions at once, honouring a date and time-of-day window on
# each. This is what makes "leave after work Friday, back before Monday" one
# request rather than a scan.
FLIGHTHOP_PATH_ROUND_TRIP_FARES=/path/to/round-trip-fares

# Deep link into the airline's own booking flow for a single leg — a normal page
# on their public site, not an API. Needs {from}, {to}, {date}. Flighthop never
# transacts; every result links out to this.
FLIGHTHOP_URL_BOOKING=https://www.example-airline.com/book?from={from}&to={to}&date={date}

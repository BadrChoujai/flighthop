# Runtime fare/route cache — regenerated on first search, and it holds a snapshot
# of a third party's pricing data. Never commit it.
app/.cache/
*.db
*.db-journal
*.db-wal
*.db-shm

# Dependencies (the app has none today, but keep this honest if that changes)
node_modules/
package-lock.json.bak

# Logs and scratch output
*.log
npm-debug.log*
*.sse
*.tmp
scratch/

# Secrets, and the upstream endpoint configuration. The example file is the
# documented shape and is meant to be committed; nothing else here is.
.env
.env.*
!.env.example
*.pem
*.key

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Added when the Vercel CLI links the project. Its own .env* rule is not kept:
# it would sit after the negation below and re-ignore the example file.
.vercel

# Restated last so it wins: the example file documents the shape and is committed.
!.env.example
